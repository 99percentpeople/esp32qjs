menu "ESP32QJS Runtime"

config ESP32QJS_ENABLE_REPL
    bool "Enable serial JavaScript REPL"
    default y
    help
        Enable the USB Serial/JTAG REPL frontend. Disable this for headless or
        production firmware that should only run the selected application.

config ESP32QJS_JS_HEAP_SIZE
    int "JavaScript heap size (bytes)"
    range 65536 4194304
    default 163840
    help
        Size of the dedicated heap buffer passed to mquickjs.

config ESP32QJS_JS_HEAP_PREFER_PSRAM
    bool "Prefer PSRAM for the JavaScript heap"
    default y
    help
        Try PSRAM first and fall back to internal memory.

config ESP32QJS_LITTLEFS_FORMAT_ON_MOUNT_FAIL
    bool "Format LittleFS when mount fails"
    default n
    help
        Development convenience that may erase application data. Production
        profiles should leave this disabled.

config ESP32QJS_SECONDARY_LITTLEFS
    bool "Mount a secondary LittleFS partition"
    depends on ESP32_MQUICKJS_FEATURE_FS
    default n
    help
        Mount a second application-defined LittleFS partition. The runtime
        only provides the mount; application code decides whether and when to
        select it as the active filesystem root.

config ESP32QJS_SECONDARY_LITTLEFS_PARTITION_LABEL
    string "Secondary LittleFS partition label"
    depends on ESP32QJS_SECONDARY_LITTLEFS
    default "data"

config ESP32QJS_SECONDARY_LITTLEFS_BASE_PATH
    string "Secondary LittleFS base path"
    depends on ESP32QJS_SECONDARY_LITTLEFS
    default "/data"

config ESP32QJS_SECONDARY_LITTLEFS_REQUIRED
    bool "Require the secondary LittleFS partition"
    depends on ESP32QJS_SECONDARY_LITTLEFS
    default y
    help
        Treat a secondary filesystem mount failure as a guarded startup
        failure. When startup guarding reaches its configured failure limit,
        the runtime starts in safe mode without the secondary filesystem so
        application recovery services can remain available.

config ESP32QJS_AUTORUN_INDEX_JS
    bool "Auto-run /littlefs/index.js at boot"
    default y

config ESP32QJS_RUNTIME_TASK_STACK_SIZE
    int "JavaScript runtime task stack size (bytes)"
    range 4096 32768
    default 8192

config ESP32QJS_RUNTIME_TASK_PRIORITY
    int "JavaScript runtime task priority"
    range 1 24
    default 1

config ESP32QJS_RUNTIME_STOP_TIMEOUT_MS
    int "Default runtime stop timeout (ms)"
    range 100 30000
    default 5000

config ESP32QJS_RUNTIME_RESTART_TIMEOUT_MS
    int "JavaScript runtime restart drain timeout (ms)"
    range 100 30000
    default 5000
    help
        Bound cancellation and native-driver draining before a JavaScript
        generation is replaced.

choice ESP32QJS_RUNTIME_RESTART_FAILURE_ACTION
    prompt "Runtime restart failure action"
    default ESP32QJS_RUNTIME_RESTART_FAILURE_REBOOT

config ESP32QJS_RUNTIME_RESTART_FAILURE_REBOOT
    bool "Reboot the device"

config ESP32QJS_RUNTIME_RESTART_FAILURE_STOP
    bool "Stop the JavaScript runtime"

endchoice

config ESP32QJS_RUNTIME_TASK_WATCHDOG
    bool "Subscribe the JavaScript runtime task to the task watchdog"
    default y if ESP_TASK_WDT_EN
    depends on ESP_TASK_WDT_EN
    help
        Use the ESP-IDF task watchdog as a final recovery layer. JavaScript
        callback deadlines should normally interrupt runaway code first.

config ESP32QJS_RUNTIME_JS_WATCHDOG
    bool "Watch outer JavaScript scheduler progress"
    default y if ESP_TASK_WDT_EN
    depends on ESP_TASK_WDT_EN
    help
        Subscribe an independent task-watchdog user that is fed only after the
        runtime returns to its outer scheduler or while a framework-owned
        native wait cooperates with that scheduler. Tight JavaScript that never
        enters a native wait still cannot conceal a turn that never returns.

config ESP32QJS_RUNTIME_STARTUP_GUARD
    bool "Track startup failures and expose persistent safe mode"
    default y
    help
        Count watchdog, panic, and uncaught startup-script failures. Two
        consecutive failures latch sys.safeMode until it is explicitly
        cleared. Applications decide what safe mode skips.

config ESP32QJS_RUNTIME_STARTUP_FAILURE_LIMIT
    int "Consecutive startup failures before safe mode"
    depends on ESP32QJS_RUNTIME_STARTUP_GUARD
    range 1 10
    default 2

config ESP32QJS_RUNTIME_STARTUP_HEALTHY_MS
    int "Healthy outer-scheduler window (ms)"
    depends on ESP32QJS_RUNTIME_STARTUP_GUARD
    range 1000 300000
    default 30000

endmenu
