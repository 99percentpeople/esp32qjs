menu "ESP32 mquickjs"

config ESP32_MQUICKJS_BOARD_NAME
    string "Board name"
    default "Generic ESP32 board"
    help
        Human-readable board name returned by esp32.info().board and shown by
        the REPL banner when serial interaction is enabled.

config ESP32_MQUICKJS_DEFAULT_EVAL_TIMEOUT_MS
    int "Default JavaScript eval timeout (ms)"
    range 50 10000
    default 250
    help
        Default timeout for direct JavaScript evaluation on the REPL thread.

config ESP32_MQUICKJS_MAX_TIMERS
    int "Maximum active JS timers"
    range 1 64
    default 16
    help
        Maximum number of active setTimeout/setInterval handles.

config ESP32_MQUICKJS_TIMER_QUEUE_LEN
    int "Timer event queue length"
    range 1 64
    default 16
    help
        Queue depth used to deliver timer callbacks back to the REPL thread.

config ESP32_MQUICKJS_MAX_SCRIPT_PATH
    int "Maximum script path length"
    range 128 1024
    default 256
    help
        Maximum LittleFS path length accepted by load() and fs APIs.

config ESP32_MQUICKJS_USER_LED_PIN
    int "User LED GPIO"
    range 0 48
    default 21
    help
        GPIO used for gpio.led() and gpio.LED_BUILTIN.

config ESP32_MQUICKJS_USER_LED_ACTIVE_LOW
    bool "User LED is active-low"
    default y
    help
        Enable this for boards where writing low turns the LED on.

config ESP32_MQUICKJS_I2C_DEFAULT_SDA_PIN
    int "Default I2C SDA GPIO"
    range 0 48
    default 5
    help
        Default SDA pin used by i2c.open() when no pin override is provided.

config ESP32_MQUICKJS_I2C_DEFAULT_SCL_PIN
    int "Default I2C SCL GPIO"
    range 0 48
    default 6
    help
        Default SCL pin used by i2c.open() when no pin override is provided.

config ESP32_MQUICKJS_I2C_DEFAULT_FREQ_HZ
    int "Default I2C clock frequency (Hz)"
    range 10000 1000000
    default 400000
    help
        Default I2C bus speed used by i2c.open().

config ESP32_MQUICKJS_I2C_DEFAULT_TIMEOUT_MS
    int "Default I2C transfer timeout (ms)"
    range 1 5000
    default 100
    help
        Default timeout used by i2c.scan(), i2c.write(), i2c.read(), and i2c.writeRead().

config ESP32_MQUICKJS_I2C_ENABLE_INTERNAL_PULLUP
    bool "Enable internal pull-up for I2C"
    default y
    help
        Enable the internal SDA/SCL pull-up resistors when opening the I2C bus.

config ESP32_MQUICKJS_WIFI_DEFAULT_TIMEOUT_MS
    int "Default Wi-Fi connect timeout (ms)"
    range 1000 120000
    default 15000
    help
        Default timeout used by wifi.connect().

config ESP32_MQUICKJS_HTTP_DEFAULT_TIMEOUT_MS
    int "Default HTTP request timeout (ms)"
    range 1000 120000
    default 15000
    help
        Default timeout used by fetch() and http.fetch().

config ESP32_MQUICKJS_HTTP_TASK_STACK_SIZE
    int "HTTP async worker task stack size (bytes)"
    range 4096 32768
    default 8192
    help
        Stack size used by the async HTTP worker task.

endmenu
