# Exercise native bindings with a compacting collection before every JS allocation.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP32QJS_ENABLE_REPL=y
CONFIG_ESP32QJS_LITTLEFS_FORMAT_ON_MOUNT_FAIL=y
CONFIG_ESP32QJS_SECONDARY_LITTLEFS=y
CONFIG_ESP32QJS_SECONDARY_LITTLEFS_PARTITION_LABEL="workspace"
CONFIG_ESP32QJS_SECONDARY_LITTLEFS_BASE_PATH="/workspace"
# CONFIG_ESP32_MQUICKJS_FEATURE_RUNTIME_LOGS is not set
CONFIG_ESP32_MQUICKJS_DEBUG_GC=y
CONFIG_ESP32_MQUICKJS_FEATURE_FS=y
CONFIG_ESP32_MQUICKJS_FEATURE_NVS=y
CONFIG_ESP32_MQUICKJS_FEATURE_GPIO=y
CONFIG_ESP32_MQUICKJS_FEATURE_LEDC=y
CONFIG_ESP32_MQUICKJS_FEATURE_ADC=y
CONFIG_ESP32_MQUICKJS_FEATURE_I2C=y
CONFIG_ESP32_MQUICKJS_FEATURE_SPI=y
CONFIG_ESP32_MQUICKJS_FEATURE_UART=y
CONFIG_ESP32_MQUICKJS_FEATURE_RMT=y
CONFIG_ESP32_MQUICKJS_FEATURE_NET=y
CONFIG_ESP32_MQUICKJS_FEATURE_WIFI=y
CONFIG_ESP32_MQUICKJS_FEATURE_ESPNOW=y
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP32_MQUICKJS_FEATURE_WIFI_CSI=y
CONFIG_ESP32_MQUICKJS_WIFI_CSI_ALLOW_PROMISCUOUS=y
CONFIG_ESP32_MQUICKJS_FEATURE_RPC=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=n
CONFIG_BT_CONTROLLER_DISABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_ESP32_MQUICKJS_FEATURE_BLE=y
CONFIG_ESP32_MQUICKJS_FEATURE_TLS=y
CONFIG_ESP32_MQUICKJS_FEATURE_SOCKET=y
CONFIG_ESP32_MQUICKJS_FEATURE_HTTP=y
CONFIG_ESP32_MQUICKJS_FEATURE_HTTP_SERVER=y
CONFIG_ESP32_MQUICKJS_FEATURE_WEBSOCKET=y
CONFIG_ESP32_MQUICKJS_FEATURE_BITMAP=y
CONFIG_ESP32_MQUICKJS_SYS_TASK_SNAPSHOT=y
CONFIG_ESP32_MQUICKJS_SYS_TASK_SNAPSHOT_MAX=32
