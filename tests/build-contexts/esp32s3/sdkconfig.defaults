# Firmware-only smoke context. Production feature and memory selection comes from the Hub Build Context.
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP32_MQUICKJS_PSRAM_MODE="none"
CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_ESP32QJS_JS_HEAP_SIZE=106496
CONFIG_ESP32_MQUICKJS_WIRELESS_INTERNAL_BUDGET_BYTES=131072
CONFIG_ESP32_MQUICKJS_WIRELESS_PSRAM_BUDGET_BYTES=0
CONFIG_ESP32_MQUICKJS_WIRELESS_CONTROL_RESERVE_BYTES=16384
CONFIG_ESP32_MQUICKJS_FEATURE_FS=y
CONFIG_ESP32QJS_ENABLE_REPL=y
CONFIG_ESP32QJS_AUTORUN_INDEX_JS=y
CONFIG_ESP32QJS_LITTLEFS_FORMAT_ON_MOUNT_FAIL=n

CONFIG_ESP32QJS_SECONDARY_LITTLEFS=y
CONFIG_ESP32QJS_SECONDARY_LITTLEFS_PARTITION_LABEL="workspace"
CONFIG_ESP32QJS_SECONDARY_LITTLEFS_BASE_PATH="/"
