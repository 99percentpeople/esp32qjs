CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
CONFIG_ESP_CONSOLE_UART_NUM=-1
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=4

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

CONFIG_ESP32_MQUICKJS_MCU_NAME="ESP32-S3"

# esp32-camera's automatic JPEG buffer is width * height / 5. That is only
# 1843 bytes at 96x96 and can overflow before a high-quality sensor JPEG emits
# its EOI marker. Keep the native capture buffer aligned with Bitmap.decode's
# bounded JPEG input instead of making low resolutions less reliable.
# CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_AUTO is not set
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_CUSTOM=y
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE=32768

# MCU capability exclusions only. Applications select every supported module.
CONFIG_ESP32_MQUICKJS_FEATURE_DAC=n
