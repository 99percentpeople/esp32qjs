CONFIG_MBEDTLS_X509_TRUSTED_CERT_CALLBACK=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
CONFIG_ESP_CONSOLE_UART_NUM=-1
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=4

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

CONFIG_ESP32_MQUICKJS_MCU_NAME="ESP32-C3"
CONFIG_ESP32_MQUICKJS_FEATURE_FS=y
CONFIG_ESP32_MQUICKJS_FEATURE_GPIO=y
CONFIG_ESP32_MQUICKJS_FEATURE_LEDC=y
CONFIG_ESP32_MQUICKJS_FEATURE_ADC=y
CONFIG_ESP32_MQUICKJS_FEATURE_DAC=n
CONFIG_ESP32_MQUICKJS_FEATURE_I2C=y
CONFIG_ESP32_MQUICKJS_FEATURE_SPI=y
CONFIG_ESP32_MQUICKJS_FEATURE_UART=y
CONFIG_ESP32_MQUICKJS_FEATURE_WIFI=y
CONFIG_ESP32_MQUICKJS_FEATURE_HTTP=y
CONFIG_ESP32_MQUICKJS_FEATURE_HTTP_SERVER=y
CONFIG_ESP32_MQUICKJS_USER_LED_PIN=-1
CONFIG_ESP32_MQUICKJS_I2C_DEFAULT_SDA_PIN=-1
CONFIG_ESP32_MQUICKJS_I2C_DEFAULT_SCL_PIN=-1
CONFIG_ESP32_MQUICKJS_SPI_DEFAULT_SCLK_PIN=-1
CONFIG_ESP32_MQUICKJS_SPI_DEFAULT_MOSI_PIN=-1
CONFIG_ESP32_MQUICKJS_SPI_DEFAULT_MISO_PIN=-1
CONFIG_ESP32_MQUICKJS_SPI_DEFAULT_CS_PIN=-1
CONFIG_ESP32_MQUICKJS_UART_DEFAULT_TX_PIN=-1
CONFIG_ESP32_MQUICKJS_UART_DEFAULT_RX_PIN=-1
