      "label": "User LED GPIO",
      "category": "LED",
      "type": "gpio",
      "allowMinusOne": false,
      "consumer": "gpio.led()"
    },
    {
      "key": "ESP32QJS_LED_ACTIVE_LOW",
      "label": "User LED active-low",
      "category": "LED",
      "type": "boolean",
      "consumer": "gpio.led()"
    },
    {
