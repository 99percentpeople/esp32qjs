# Active MCU profile from `configs/mcus/*/.env`.
MCU=esp32s3
APP=minimal
# Optional direct override when the profile lives outside `configs/mcus/`
# or when you want to point at a specific MCU profile directory.
# MCU_FILE=configs/mcus/esp32s3
# APP_FILE=apps/minimal/app.env
# External example: APP_FILE=../agent/device/app.env
# Optional application-input overrides; normally read from app.env.
# APP_SDKCONFIG_DEFAULTS=apps/minimal/sdkconfig.defaults
# PARTITION_TABLE=/absolute/path/to/an/explicit/partition.csv

# Tool locations on the development machine.
IDF_PATH=/path/to/esp-idf

# Optional per-user overrides. MCU profile defaults still apply when omitted.
# Single device target used by chip-id/flash/monitor/test/server:
# - local serial: /dev/ttyACM0 or COM3
# - remote RFC2217: rfc2217://192.168.68.54:4000?ign_set_control&timeout=10
TARGET=
MONITOR_BAUD=115200
LISTEN_PORT=4000
SERVER_PYTHON_EXE=auto
# Optional JS network-test settings used by `python scripts/remote.py test --network`.
# TEST_WIFI_SSID=
# TEST_WIFI_PASSWORD=
# TEST_HTTP_URL=

# Optional JSON merged into globalThis.testConfig for device-specific JS test overrides.
# SPI loopback is enabled with `test --loopback`; this example overrides pins for same-pin loopback.
# TEST_JS_CONFIG={"spiLoopback":{"sclk":1,"mosi":2,"miso":2,"cs":-1,"freqHz":500000}}
