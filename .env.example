# Remote RFC2217 target used by `chip-id`, `flash`, `monitor`, and `flash-monitor`.
REMOTE_HOST=192.168.68.54
REMOTE_PORT=4000
# Optional full override when host/port is not enough.
# REMOTE_URL=rfc2217://192.168.68.54:4000?ign_set_control&timeout=10
# Legacy alias also accepted: ESPPORT=rfc2217://192.168.68.54:4000?ign_set_control&timeout=10

# Tool locations on the development machine.
ESP_IDF_PATH=/home/zach/esp/esp-idf
MONITOR_BAUD=115200

# RFC2217 server defaults for the Windows machine that owns the board.
COM_PORT=COM3
LISTEN_PORT=4000
SERVER_PYTHON_EXE=auto
