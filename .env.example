# Active board profile from `configs/boards/*/.env`.
BOARD=xiao_esp32s3
# Optional direct override when the profile lives outside `configs/boards/`
# or when you want to point at a specific board directory.
# BOARD_FILE=configs/boards/xiao_esp32s3

# Tool locations on the development machine.
IDF_PATH=/home/zach/esp/esp-idf

# Optional per-user overrides. Board profile defaults still apply when omitted.
# Single device target used by chip-id/flash/monitor/test/server:
# - local serial: /dev/ttyACM0 or COM3
# - remote RFC2217: rfc2217://192.168.68.54:4000?ign_set_control&timeout=10
TARGET=
MONITOR_BAUD=115200
LISTEN_PORT=4000
SERVER_PYTHON_EXE=auto
# Optional JS network-test settings used by `python scripts/remote.py test --network`.
# TEST_WIFI_SSID=
# TEST_WIFI_PASSWORD=
# TEST_HTTP_URL=

# Optional JSON merged into globalThis.testConfig for board-specific JS test overrides.
# SPI loopback is enabled with `test --loopback`; this example overrides pins for same-pin loopback.
# TEST_JS_CONFIG={"spiLoopback":{"sclk":1,"mosi":2,"miso":2,"cs":-1,"freqHz":500000}}
