# Intrinsic MCU defaults; product and Board inputs come from the Build Context.
MCU=esp32s3
BUILD_CONTEXT=tests/build-contexts/esp32s3

# ESP-IDF installation.
IDF_PATH=/path/to/esp-idf

# Optional device target for chip-id/flash/monitor/test/server.
# Examples: /dev/ttyACM0, COM3, or an rfc2217:// URL.
TARGET=
MONITOR_BAUD=115200
LISTEN_PORT=4000
SERVER_PYTHON_EXE=auto

# Optional device-backed network tests.
# TEST_WIFI_SSID=
# TEST_WIFI_PASSWORD=
# TEST_HTTP_URL=https://example.com

# Optional JSON merged into globalThis.testConfig for physical test overrides.
# TEST_JS_CONFIG={"spiLoopback":{"sclk":1,"mosi":2,"miso":2,"cs":-1,"freqHz":500000}}
